{
  "name": "dsh-handoff-hub",
  "version": "1.1.0",
  "description": "Simultaneous handoff-document sync for independent DeepSeek Harness sessions, with targeted directory-change reminders and a session-group management panel.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LiFePO2/dsh-handoff-hub.git"
  },
  "homepage": "https://github.com/LiFePO2/dsh-handoff-hub#readme",
  "bugs": {
    "url": "https://github.com/LiFePO2/dsh-handoff-hub/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "handoff",
    "multi-agent",
    "multi-session",
    "collaboration",
    "cordis",
    "reminder"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "docs",
    "market",
    "README.md",
    "README.zh.md",
    "CREDITS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/manifest.mjs && node test/harness.mjs"
  },
  "dsh": {
    "verifiedAgainst": "0.2.2-rc.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
